# Plantilla de configuracion. INICIAR.bat la copia como .env si no existe.

# Puerto de la app en tu red
PORT=3000

# Carpeta de los PDF de los expedientes y tamano maximo por archivo
UPLOAD_DIR=./uploads
MAX_PDF_MB=25

# Base de datos. Vacio o comentado = PostgreSQL embebido (datos en pgdata\).
# Para usar un PostgreSQL propio, descomenta y ajusta:
# DATABASE_URL=postgres://usuario:clave@servidor:5432/gastos_ti
