    "dev": "node --watch server/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "embedded-postgres": "^17.10.0-beta.17",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.2",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.13.1"
  }
}
