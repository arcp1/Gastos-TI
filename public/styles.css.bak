/* Gastos TI · CGR — navy ink + magenta accent. Siempre en tema claro, fondo blanco. */
:root {
  color-scheme: light;
  --bg: #ffffff; --surface: #ffffff; --surface-2: #eeeef4; --line: #d9d9e4;
  --fg: #16193a; --muted: #5f6282; --accent: #d6127a; --accent-soft: #fbe3f0; --navy: #1d2a5e;
  --ok: #1d8a5a; --warn: #c7780a; --bad: #c62828;
  --font-display: "Manrope", "Segoe UI", system-ui, sans-serif;
  --font-body: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
  --radius: 10px; --shadow: 0 1px 2px rgba(22,25,58,.06), 0 4px 16px rgba(22,25,58,.05);
}
* { box-sizing: border-box; }
html, body { margin: 0; }
body { background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: 14px; line-height: 1.45; }
.wrap { max-width: 1200px; margin: 0 auto; padding-inline: 16px; padding-block: 18px 56px; display: grid; gap: 18px; }
h1, h2, h3 { font-family: var(--font-display); margin: 0; text-wrap: balance; }
h1 { font-size: 22px; font-weight: 800; letter-spacing: -.01em; }
h2 { font-size: 16px; font-weight: 700; }
h3 { font-size: 14px; font-weight: 700; }
.num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; }
.note { font-size: 12px; color: var(--muted); margin: 0; }
.muted { color: var(--muted); }

.top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
.brand { display: flex; align-items: center; gap: 12px; }
.mark { width: 40px; height: 36px; border-radius: 9px; background: var(--navy); display: flex; align-items: center; justify-content: center; color: #fff; font-family: var(--font-display); font-weight: 800; font-size: 12px; white-space: nowrap; letter-spacing: 0; flex: none; }
.mark span { color: var(--accent); }
.brand p { margin: 0; color: var(--muted); font-size: 12px; }
.period { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.period select { width: auto; }
.status { font-size: 12px; color: var(--muted); display: inline-flex; align-items: center; gap: 6px; }
.status i { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); display: inline-block; }
.status.err i { background: var(--bad); }

nav.tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
nav.tabs button { border: none; background: none; padding: 10px 14px; font-weight: 600; color: var(--muted); border-bottom: 2px solid transparent; margin-bottom: -1px; border-radius: 0; }
nav.tabs button:hover { color: var(--fg); background: none; }
nav.tabs button.active { color: var(--accent); border-bottom-color: var(--accent); }
.view[hidden] { display: none; }
.view { display: grid; gap: 18px; }

select, input, textarea, button { font: inherit; color: inherit; }
select, input, textarea { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; min-width: 0; width: 100%; }
:is(select, input, textarea, button):focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
button { border: 1px solid var(--line); background: var(--surface); border-radius: 8px; padding: 8px 14px; cursor: pointer; font-weight: 500; }
button:hover { background: var(--surface-2); }
button.primary { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
button.primary:hover { filter: brightness(1.08); }
button.ghost { background: transparent; border-color: transparent; color: var(--muted); padding: 4px 8px; }
button.ghost:hover { color: var(--fg); background: var(--surface-2); }
button.danger { color: var(--bad); border-color: var(--bad); background: transparent; }
button.small { padding: 4px 10px; font-size: 12px; }
button:disabled { opacity: .5; cursor: default; }
a { color: var(--accent); }

.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
.kpi { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; display: grid; gap: 4px; align-content: start; }
.kpi .v { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 22px; font-weight: 500; letter-spacing: -.01em; }
.kpi .s { font-size: 12px; color: var(--muted); }
.kpi.hi { border-top: 3px solid var(--accent); }
.meter { height: 6px; background: var(--surface-2); border-radius: 3px; overflow: hidden; margin-top: 6px; }
.meter b { display: block; height: 100%; background: var(--navy); border-radius: 3px; }
.meter b.warn, .catbar b.warn { background: var(--warn); } .meter b.bad, .catbar b.bad { background: var(--bad); }

.panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 16px; display: grid; gap: 12px; min-width: 0; align-content: start; }
.panel-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
.panel-head p { margin: 0; color: var(--muted); font-size: 12px; }
.two { display: grid; grid-template-columns: 1.4fr 1fr; gap: 18px; }
.two.even { grid-template-columns: 1fr 1fr; }
@media (max-width: 860px) { .two, .two.even { grid-template-columns: 1fr; } }

/* Mes más caro */
.reason { background: var(--accent-soft); border-radius: var(--radius); padding: 14px 16px; display: grid; gap: 8px; }
.reason .big { font-family: var(--font-display); font-size: 20px; font-weight: 800; }
.reason .big .num { font-family: var(--font-mono); font-weight: 500; }
.reason ul { margin: 0; padding-left: 18px; display: grid; gap: 4px; }
.months { display: grid; gap: 6px; }
.month-row { display: grid; grid-template-columns: 90px 1fr 120px; gap: 10px; align-items: center; font-size: 13px; cursor: pointer; padding: 4px 6px; border-radius: 6px; }
.month-row:hover { background: var(--surface-2); }
.month-row.sel { background: var(--surface-2); outline: 1px solid var(--line); }
.month-row .bar { height: 14px; background: var(--surface-2); border-radius: 3px; overflow: hidden; position: relative; }
.month-row .bar b { display: block; height: 100%; background: var(--navy); }
.month-row.top .bar b { background: var(--accent); }
.month-row .bar i { position: absolute; top: -2px; bottom: -2px; width: 0; border-left: 2px dashed var(--accent); }
.month-row .num { text-align: right; }
.detail { display: grid; gap: 8px; font-size: 13px; }
.detail .pair { display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px dashed var(--line); padding: 3px 0; }

.chart { width: 100%; height: auto; display: block; }
.chart text { font-family: var(--font-mono); font-size: 11px; fill: var(--muted); }
.chart .grid { stroke: var(--line); }
.chart .bar { fill: var(--navy); } .chart .bar.cur { fill: var(--accent); } .chart .bar.future { fill: var(--surface-2); }
.chart .budget { stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 4 4; fill: none; }
.legend { display: flex; gap: 16px; font-size: 12px; color: var(--muted); flex-wrap: wrap; }
.legend span::before { content: ""; display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; background: var(--navy); }
.legend .l-cur::before { background: var(--accent); }
.legend .l-bud::before { background: none; border-top: 2px dashed var(--accent); height: 0; vertical-align: 2px; }

.tbl-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: middle; white-space: nowrap; }
th { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 600; }
td.r, th.r { text-align: right; }
td.num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
tbody tr:hover { background: var(--surface-2); }
tbody tr.sel { background: var(--accent-soft); }
tr.total td { font-weight: 600; border-bottom: none; border-top: 2px solid var(--line); }
td.concept { white-space: normal; min-width: 200px; max-width: 380px; }
.catbar { display: inline-block; width: 56px; height: 6px; background: var(--surface-2); border-radius: 3px; vertical-align: middle; margin-left: 8px; overflow: hidden; }
.catbar b { display: block; height: 100%; background: var(--navy); }
.pill { display: inline-block; padding: 2px 8px; border-radius: 99px; font-size: 11px; font-weight: 600; }
.pill.pagado { background: color-mix(in srgb, var(--ok) 15%, transparent); color: var(--ok); }
.pill.pendiente { background: color-mix(in srgb, var(--warn) 18%, transparent); color: var(--warn); }
.empty { color: var(--muted); text-align: center; padding: 24px; white-space: normal; }

/* Pasos del expediente (cotización → OC → factura → albarán) */
.steps { display: inline-flex; gap: 3px; vertical-align: middle; }
.steps i { width: 18px; height: 8px; border-radius: 2px; background: var(--surface-2); border: 1px solid var(--line); display: inline-block; }
.steps i.on { background: var(--ok); border-color: var(--ok); }
.flow { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
@media (max-width: 720px) { .flow { grid-template-columns: repeat(2, 1fr); } }
.stage { border: 1px solid var(--line); border-radius: var(--radius); padding: 10px 12px; display: grid; gap: 6px; align-content: start; position: relative; }
.stage.done { border-color: var(--ok); }
.stage .st-head { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
.stage .st-head b { font-family: var(--font-display); font-size: 13px; }
.stage .badge { width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font-size: 11px; font-weight: 700; background: var(--surface-2); color: var(--muted); }
.stage.done .badge { background: var(--ok); color: #fff; }
.doc { display: grid; gap: 2px; font-size: 12px; padding: 6px 8px; background: var(--surface-2); border-radius: 6px; }
.doc .doc-row { display: flex; justify-content: space-between; gap: 6px; align-items: center; }
.doc a { font-weight: 600; text-decoration: none; }
.doc a:hover { text-decoration: underline; }
.upload { display: grid; gap: 6px; font-size: 12px; }
.upload input { padding: 6px 8px; font-size: 12px; }
.upload input[type=file] { padding: 4px; }
.drawer { display: grid; gap: 12px; }
.drawer-head { display: flex; justify-content: space-between; align-items: start; gap: 10px; flex-wrap: wrap; }
.drawer-head .amount { font-family: var(--font-mono); font-size: 20px; }

.form { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }
.form label { display: grid; gap: 4px; font-size: 12px; color: var(--muted); font-weight: 500; min-width: 0; }
.form .c1 { grid-column: span 1; } .form .c2 { grid-column: span 2; } .form .c3 { grid-column: span 3; } .form .c4 { grid-column: span 4; } .form .c6 { grid-column: span 6; }
.form .check { display: flex; align-items: center; gap: 8px; align-self: end; padding-bottom: 8px; }
.form .check input { width: auto; }
.form .actions { grid-column: span 6; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.totalbox { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 13px; color: var(--muted); margin-left: auto; }
.totalbox b { color: var(--fg); font-weight: 500; }
@media (max-width: 720px) { .form { grid-template-columns: repeat(2, 1fr); } .form .c3, .form .c4, .form .c6, .form .actions { grid-column: span 2; } }
.filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.filters select, .filters input { width: auto; }
.filters input { min-width: 180px; }
.msg { font-size: 12px; color: var(--ok); } .msg.err { color: var(--bad); }
.row-actions { display: inline-flex; gap: 2px; }
.confirm { display: inline-flex; gap: 4px; align-items: center; font-size: 12px; }

/* Línea de tiempo */
.timeline { display: grid; gap: 0; position: relative; padding-left: 22px; }
.timeline::before { content: ""; position: absolute; left: 7px; top: 6px; bottom: 6px; width: 2px; background: var(--line); }
.tl-month { font-family: var(--font-display); font-weight: 800; font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); padding: 14px 0 6px; position: relative; }
.tl-month::before { content: ""; position: absolute; left: -19px; top: 16px; width: 10px; height: 10px; border-radius: 50%; background: var(--surface); border: 2px solid var(--muted); }
.tl-month .num { color: var(--fg); margin-left: 8px; font-weight: 500; }
.tl-item { display: grid; grid-template-columns: 92px 1fr auto; gap: 10px; padding: 7px 0; border-bottom: 1px dashed var(--line); font-size: 13px; position: relative; align-items: start; }
.tl-item::before { content: ""; position: absolute; left: -17px; top: 13px; width: 6px; height: 6px; border-radius: 50%; background: var(--navy); }
.tl-item.gasto_creado::before { background: var(--accent); }
.tl-item.gasto_pagado::before { background: var(--ok); }
.tl-item.documento_subido::before { background: var(--navy); }
.tl-item.documento_borrado::before, .tl-item.gasto_editado::before { background: var(--muted); }
.tl-item .when { font-family: var(--font-mono); color: var(--muted); font-size: 12px; padding-top: 1px; }
.tl-item .what { min-width: 0; }
.tl-item .what small { color: var(--muted); display: block; }
.tl-item .what a { color: inherit; text-decoration: none; font-weight: 600; }
.tl-item .what a:hover { color: var(--accent); }
.tl-item .amt { font-family: var(--font-mono); text-align: right; white-space: nowrap; }
@media (max-width: 560px) { .tl-item { grid-template-columns: 1fr; } .tl-item .amt { text-align: left; } }

/* Presupuesto */
.budget-grid { display: grid; grid-template-columns: 1fr 160px auto; gap: 8px; align-items: center; }
.budget-grid .hd { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 600; }
.budget-grid input { text-align: right; font-family: var(--font-mono); }
.addcat { display: flex; gap: 8px; } .addcat input { flex: 1; }
@media (max-width: 520px) { .budget-grid { grid-template-columns: 1fr 120px auto; } }

.toast { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); background: var(--fg); color: var(--bg); padding: 10px 16px; border-radius: 8px; font-size: 13px; box-shadow: var(--shadow); opacity: 0; pointer-events: none; transition: opacity .2s; max-width: calc(100vw - 32px); }
.toast.show { opacity: 1; }
.toast.err { background: var(--bad); color: #fff; }
@media (prefers-reduced-motion: reduce) { .toast { transition: none; } }

/* Contenedores en azul marino (CGR) sobre el fondo blanco de la página.
   Dentro de cada contenedor se redefinen los tokens para que texto, campos,
   barras y pills tengan contraste sobre el azul. */
.panel, .kpi {
  --surface: #26356e; --surface-2: #31437f; --line: rgba(255,255,255,.18);
  --fg: #ffffff; --muted: #b9bedc; --accent: #f23c97; --accent-soft: rgba(242,60,151,.22);
  --navy: #8fa0e8; --ok: #4fc28a; --warn: #f0b253; --bad: #ff8a8a;
  --shadow: 0 2px 6px rgba(22,25,58,.18), 0 10px 24px rgba(22,25,58,.14);
  background: #1d2a5e; color: var(--fg); border-color: #1d2a5e; color-scheme: dark;
}
.panel ::placeholder, .kpi ::placeholder { color: rgba(255,255,255,.45); }
.panel button.primary, .kpi button.primary { color: #ffffff; }
.panel .pill.ejemplo { background: var(--accent-soft); color: #ffd1e6; }
.panel[hidden], .view[hidden] { display: none; }

/* Carga de factura en el formulario */
.factura-zone { display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border: 1.5px dashed var(--line); border-radius: var(--radius); background: var(--surface-2); }
.factura-zone.ok { border-color: var(--ok); } .factura-zone.warn { border-color: var(--warn); }
.factura-pick { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; cursor: pointer; font-size: 12.5px; color: var(--muted); font-weight: 500; }
.factura-pick input[type=file] { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; }
.factura-btn { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border-radius: 8px; background: var(--accent); color: #fff; font-weight: 600; font-size: 13px; white-space: nowrap; }
.factura-pick:hover .factura-btn { filter: brightness(1.08); }
.factura-pick input:focus-visible + .factura-btn { outline: 2px solid #fff; outline-offset: 2px; }
.factura-hint { flex: 1 1 260px; min-width: 0; }
.factura-chip { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; font-size: 12.5px; color: var(--fg); }
.prov-form { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.prov-form input[type=text] { flex: 1 1 200px; width: auto; }
.prov-form input#provRfc { flex: 0 1 180px; font-family: var(--font-mono); text-transform: uppercase; }
.form label[hidden] { display: none; }
.form .factura-pick { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; }
.flow { grid-template-columns: repeat(5, 1fr); }
@media (max-width: 900px) { .flow { grid-template-columns: repeat(2, 1fr); } }
.stage.opcional { border-style: dashed; }
.stage.opcional.done { border-style: solid; }

/* Elección del tipo de compra */
.chooser { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
@media (max-width: 640px) { .chooser { grid-template-columns: 1fr; } }
.choice { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-height: 120px; padding: 18px 20px; border-radius: 12px; border: 1.5px solid var(--line); background: var(--surface); color: var(--fg); text-align: left; cursor: pointer; }
.choice:hover, .choice:focus-visible { border-color: var(--accent); background: var(--surface-2); }
.choice svg { color: var(--accent); }
.choice b { font-family: var(--font-display); font-size: 17px; font-weight: 700; }
.choice span { font-size: 12.5px; color: var(--muted); }
.form .solo-proveedor, .form .solo-linea { display: grid; }
.form.tipo-linea .solo-proveedor, .form.tipo-proveedor .solo-linea { display: none; }
.pill.linea { background: color-mix(in srgb, var(--navy) 28%, transparent); color: var(--fg); }
.form .check.solo-proveedor, .form .check.solo-linea { display: flex; }
.form.tipo-linea .check.solo-proveedor, .form.tipo-proveedor .check.solo-linea { display: none; }

/* ===== Captura rápida: qué compraste y cuánto costó ===== */
.capture { gap: 18px; padding: 22px 24px 20px; }
.seg { display: inline-flex; align-self: flex-start; padding: 4px; border-radius: 12px; background: rgba(0,0,0,.22); gap: 4px; }
.seg-btn { border: none; background: transparent; color: var(--muted); font-weight: 600; font-size: 13.5px; padding: 9px 16px; border-radius: 9px; min-height: 40px; }
.seg-btn:hover { background: rgba(255,255,255,.06); color: var(--fg); }
.seg-btn.active { background: var(--accent); color: #fff; }
.capture-form { display: flex; flex-direction: column; gap: 16px; }
.capture-form label.big { display: flex; flex-direction: column; gap: 8px; font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--fg); min-width: 0; }
.capture-form label.big input { min-height: 52px; font-size: 17px; padding: 0 16px; border-radius: 12px; border: 1.5px solid var(--line); background: rgba(255,255,255,.06); color: var(--fg); }
.capture-form label.big input:focus-visible { outline: 2px solid var(--accent); outline-offset: 0; border-color: var(--accent); }
.amount-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; }
.amount-row .amount { flex: 0 1 320px; }
.money-wrap { position: relative; display: flex; }
.money-wrap .cur { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); font-family: var(--font-mono); font-size: 20px; color: var(--muted); }
.money-wrap input { width: 100%; padding-left: 38px !important; font-family: var(--font-mono); font-size: 22px !important; font-variant-numeric: tabular-nums; }
.amount-row .chip { margin-bottom: 8px; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.chip { display: inline-flex; align-items: center; gap: 7px; min-height: 36px; padding: 0 12px; border-radius: 99px; border: 1px solid var(--line); background: rgba(255,255,255,.05); color: var(--fg); font-size: 13px; cursor: pointer; }
.chip:hover { background: rgba(255,255,255,.1); }
.chip svg { color: var(--muted); flex: none; }
.chip select, .chip input[type=date], .chip input[type=text] { border: none; background: transparent; color: var(--fg); font: inherit; font-size: 13px; padding: 0; min-height: 34px; width: auto; min-width: 0; cursor: pointer; }
.chip select { appearance: none; -webkit-appearance: none; padding-right: 16px; background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%); background-position: calc(100% - 8px) 55%, calc(100% - 3px) 55%; background-size: 5px 5px, 5px 5px; background-repeat: no-repeat; max-width: 240px; text-overflow: ellipsis; }
.chip select option { color: #16193a; background: #fff; }
.chip input[type=text] { width: 180px; cursor: text; }
.chip input[type=date] { color-scheme: dark; }
.chip:focus-within { border-color: var(--accent); }
.chip-toggle input { width: 16px; height: 16px; margin: 0; accent-color: var(--ok); cursor: pointer; }
.chip-toggle:has(input:checked) { background: color-mix(in srgb, var(--ok) 22%, transparent); border-color: var(--ok); }
.capture-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; padding-top: 4px; }
.big-btn { min-height: 48px; padding: 0 24px; font-size: 15px; border-radius: 12px; }
.capture-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; font-size: 12.5px; }
.linkish { position: relative; display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-weight: 600; cursor: pointer; min-height: 32px; }
.linkish:hover { text-decoration: underline; }
.linkish input[type=file] { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; }
.linkish input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 4px; }
.capture .factura-chip { padding: 10px 14px; border-radius: 10px; background: rgba(255,255,255,.06); border: 1px dashed var(--line); }
@media (max-width: 720px) { .capture-form label.big input { font-size: 16px; } .amount-row .amount { flex-basis: 100%; } }
.chip[hidden], .factura-chip[hidden], .capture [hidden] { display: none !important; }
.capture .seg { justify-self: start; }

/* =====================================================================
   LIQUID GLASS — contenedores de vidrio translúcido sobre un fondo con
   luces suaves (azul marino y magenta). Sustituye los contenedores azules.
   ===================================================================== */
:root {
  --glass: rgba(255,255,255,.52);
  --glass-strong: rgba(255,255,255,.72);
  --glass-edge: rgba(255,255,255,.85);
  --glass-shadow: 0 1px 0 rgba(255,255,255,.9) inset, 0 -1px 0 rgba(22,25,58,.06) inset, 0 12px 40px rgba(22,25,58,.10), 0 2px 8px rgba(22,25,58,.05);
  --bg: #f3f4fb;
}
body { background: var(--bg); }
body::before {
  content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none;
  background:
    radial-gradient(44rem 32rem at 6% -4%, rgba(29,42,94,.55), transparent 62%),
    radial-gradient(38rem 30rem at 96% 10%, rgba(214,18,122,.42), transparent 62%),
    radial-gradient(44rem 34rem at 58% 104%, rgba(29,42,94,.38), transparent 62%),
    radial-gradient(30rem 24rem at 22% 68%, rgba(214,18,122,.22), transparent 62%),
    radial-gradient(24rem 20rem at 80% 55%, rgba(120,140,230,.30), transparent 62%),
    linear-gradient(180deg, #f6f6fd 0%, #eceef8 100%);
}
.panel, .kpi, .choice {
  /* tokens claros dentro del vidrio */
  --surface: rgba(255,255,255,.62); --surface-2: rgba(29,42,94,.07); --line: rgba(29,42,94,.14);
  --fg: #16193a; --muted: #5f6282; --accent: #d6127a; --accent-soft: rgba(214,18,122,.12);
  --navy: #1d2a5e; --ok: #1d8a5a; --warn: #c7780a; --bad: #c62828;
  --shadow: var(--glass-shadow);
  background: linear-gradient(160deg, rgba(255,255,255,.66) 0%, rgba(255,255,255,.40) 60%, rgba(255,255,255,.50) 100%); color: var(--fg); color-scheme: light;
  border: 1px solid var(--glass-edge); border-radius: 18px;
  box-shadow: var(--glass-shadow);
  -webkit-backdrop-filter: blur(28px) saturate(170%); backdrop-filter: blur(28px) saturate(170%);
}
.kpi { border-radius: 16px; }
.kpi.hi { border-top: 1px solid var(--glass-edge); box-shadow: var(--glass-shadow), 0 0 0 1.5px rgba(214,18,122,.35) inset; }
.panel ::placeholder, .kpi ::placeholder { color: rgba(22,25,58,.4); }
.panel .pill.ejemplo { background: var(--accent-soft); color: #a50d5e; }
.pill.linea { background: rgba(29,42,94,.1); color: #1d2a5e; }
.pill.pagado { background: rgba(29,138,90,.14); color: #1d8a5a; }
.pill.pendiente { background: rgba(199,120,10,.16); color: #a35f00; }
.panel select, .panel input, .panel textarea, .kpi select, .kpi input {
  background: var(--glass-strong); border: 1px solid rgba(29,42,94,.14); color: var(--fg);
  box-shadow: 0 1px 0 rgba(255,255,255,.8) inset;
}
.panel button, .kpi button { background: var(--glass-strong); border: 1px solid rgba(29,42,94,.14); color: var(--fg); box-shadow: 0 1px 0 rgba(255,255,255,.8) inset; }
.panel button:hover { background: rgba(255,255,255,.9); }
.panel button.ghost, .kpi button.ghost { background: transparent; border-color: transparent; box-shadow: none; color: var(--muted); }
.panel button.ghost:hover { background: rgba(29,42,94,.07); color: var(--fg); }
button.primary, .panel button.primary, .factura-btn, .seg-btn.active {
  background: linear-gradient(180deg, #ef3d98 0%, #d6127a 55%, #c40f6f 100%); border: 1px solid rgba(255,255,255,.35); color: #fff;
  box-shadow: 0 1px 0 rgba(255,255,255,.45) inset, 0 6px 18px rgba(214,18,122,.28);
}
button.primary:hover, .panel button.primary:hover { filter: brightness(1.06); background: linear-gradient(180deg, #ef3d98 0%, #d6127a 55%, #c40f6f 100%); }
button.danger, .panel button.danger { background: transparent; color: var(--bad); border-color: rgba(198,40,40,.4); box-shadow: none; }
.tbl-wrap th { color: var(--muted); }
tbody tr:hover { background: rgba(255,255,255,.45); }
tbody tr.sel { background: rgba(214,18,122,.08); }
.tl-month::before { background: #fff; }
.toast { background: rgba(22,25,58,.92); color: #fff; -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,.2); }

/* Cabecera y pestañas sobre el fondo */
.period select, .period button, .status { background: var(--glass); border-color: var(--glass-edge); box-shadow: var(--glass-shadow); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); border-radius: 12px; }
.status { padding: 8px 12px; }
nav.tabs { border-bottom-color: rgba(29,42,94,.12); }

/* Captura rápida en vidrio */
.capture .seg { background: rgba(29,42,94,.08); border: 1px solid rgba(255,255,255,.7); box-shadow: 0 1px 0 rgba(255,255,255,.8) inset; }
.seg-btn { color: var(--muted); }
.seg-btn:hover { background: rgba(255,255,255,.5); color: var(--fg); }
.capture-form label.big input { background: var(--glass-strong); border: 1.5px solid rgba(29,42,94,.12); box-shadow: 0 1px 0 rgba(255,255,255,.9) inset, 0 2px 8px rgba(22,25,58,.04); }
.capture-form label.big input:focus-visible { border-color: var(--accent); box-shadow: 0 0 0 4px rgba(214,18,122,.15); outline: none; }
.chip { background: var(--glass-strong); border: 1px solid rgba(29,42,94,.12); color: var(--fg); box-shadow: 0 1px 0 rgba(255,255,255,.85) inset, 0 1px 3px rgba(22,25,58,.05); }
.chip:hover { background: rgba(255,255,255,.95); }
.chip select, .chip input[type=date], .chip input[type=text] { background-color: transparent; border: none; box-shadow: none; }
.chip select { background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%); }
.chip input[type=date] { color-scheme: light; }
.chip-toggle:has(input:checked) { background: rgba(29,138,90,.14); border-color: rgba(29,138,90,.45); }
.capture .factura-chip { background: rgba(255,255,255,.5); border: 1px dashed rgba(29,42,94,.25); }
.factura-zone { background: rgba(255,255,255,.4); border-color: rgba(29,42,94,.2); }

/* Expediente y documentos */
.stage { background: rgba(255,255,255,.4); border: 1px solid rgba(29,42,94,.12); border-radius: 14px; }
.stage.done { border-color: rgba(29,138,90,.5); background: rgba(29,138,90,.06); }
.stage .badge { background: rgba(29,42,94,.08); color: var(--muted); }
.doc { background: rgba(255,255,255,.6); }
.reason { background: rgba(214,18,122,.10); border: 1px solid rgba(214,18,122,.18); }
.meter, .catbar, .month-row .bar { background: rgba(29,42,94,.1); }
.month-row:hover, .month-row.sel { background: rgba(255,255,255,.55); outline: none; }
.steps i { background: rgba(29,42,94,.1); border-color: rgba(29,42,94,.15); }
.steps i.on { background: var(--ok); border-color: var(--ok); }
details summary { color: var(--fg); }
@media (prefers-reduced-transparency: reduce) { .panel, .kpi, .choice { background: rgba(255,255,255,.92); -webkit-backdrop-filter: none; backdrop-filter: none; } }
.chip select { background-color: transparent; background-size: 5px 5px, 5px 5px; background-position: calc(100% - 8px) 55%, calc(100% - 3px) 55%; background-repeat: no-repeat; }
.panel .seg-btn { background: transparent; border: none; box-shadow: none; color: var(--muted); }
.panel .seg-btn:hover { background: rgba(255,255,255,.55); color: var(--fg); }
.panel .seg-btn.active { background: linear-gradient(180deg, #ef3d98 0%, #d6127a 55%, #c40f6f 100%); color: #fff; border: 1px solid rgba(255,255,255,.35); box-shadow: 0 1px 0 rgba(255,255,255,.45) inset, 0 6px 18px rgba(214,18,122,.28); }
